# ── OpenRouter ──────────────────────────────────────────────────
# API key from https://openrouter.ai/keys
# MODEL is a single string so you can swap quality without code changes:
#   openai/gpt-4o-mini       cheapest, fine for routine quoting
#   openai/gpt-4o            ~10x cost, much better Hinglish handling
#   anthropic/claude-sonnet-4 best quality for B2B Indian conversations
OPENROUTER_API_KEY=sk-or-v1-...
MODEL=openai/gpt-4o-mini

# ── Meta WhatsApp Cloud API ─────────────────────────────────────
# From your Meta developer app → WhatsApp → API Setup.
# WA_VERIFY_TOKEN is a string YOU make up; you'll paste the same
# value when configuring the webhook in Meta's UI.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=florista-pick-any-secret-string

# ── Apps Script tool layer ──────────────────────────────────────
# The /exec URL after deploying apps_script/Code.gs as a Web App.
# See .kiro/steering/whatsapp-bot.md for setup.
TOOLS_ENDPOINT=https://script.google.com/macros/s/.../exec

# ── Optional ────────────────────────────────────────────────────
# Owner number that receives escalation alerts (E.164, no +).
OWNER_PHONE=917588447595

# Where LangGraph stores conversation state (mount a volume in prod).
CHECKPOINT_DB=data/checkpoints.sqlite
